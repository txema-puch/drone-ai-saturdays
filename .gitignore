.DS_Store
Thumbs.db

########################################
# Otros                                #
########################################
*.lock
# The serving image is deliberately resolved and hash-locked for Linux/amd64.
!delivery/container/requirements-linux-x86_64.lock
.claude
.docs
.data
.claude/

########################################
# Local collaboration workspace         #
########################################
# Raw plans, handoffs, task boards, weekly notes, agent instructions and
# writeup drafts are intentionally local. Durable decisions and evidence live
# in the tracked docs/ tree; the pre-restructure tag preserves older copies.
.workspace/
/CLAUDE.md
/backend/docs/writeup/
/docs/writeup/

########################################
# Agent-session artifacts              #
########################################
# Codex/agent scratch — local session state + a broken /Codex/-path copy of
# CLAUDE.md. CLAUDE.md is the canonical agent-instructions file for the team.
.context/
AGENTS.md
.gstack/

########################################
# Vendored upstream (SADAR)            #
########################################
# external/ holds the vendored SADAR repo (devrup404, MIT) read during the
# merge. We copy only what we reuse into frontend/ with attribution; the full
# clone must never be committed.
external/
