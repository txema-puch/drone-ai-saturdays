# EXCEPTION (#27): version the small (~1.4 MB) FROZEN Phase-7 bench so the blind
# Phase-7 test is byte-identical + reproducible across machines. The big regenerable
# caches (clean_df/meta parquets, 138 MB) stay ignored via `phase6/*` below.
!backend/models/phase6/
backend/models/phase6/*
!backend/models/phase6/lstm_ae_best.pt
!backend/models/phase6/knn_train_summary.npy
!backend/models/phase6/scaler.joblib
!backend/models/phase6/knn_frozen_manifest.json
!backend/models/phase6/split_ids.json
