*.ipynb_checkpoints

########################################
# Datos y modelos                      #
########################################
/data/
backend/models/*
backend/notebooks/
/backend/docs/

########################################
# Node/Frontend                        #
########################################
node_modules/
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo

