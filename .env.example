# Copy this file to .env and fill in the values. Never commit .env.
# Share secrets via password manager (1Password, Bitwarden), not Discord/email.

# OpenSky Network — register at https://opensky-network.org (research account
# required for the Trino/Impala bulk export used in backend/scripts/export_lemd_2025_sample.py)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Supabase project — ask Monica for the project URL and the service-role key.
# The service-role key bypasses RLS; treat it like a password.
SUPABASE_URL=
SUPABASE_KEY=
