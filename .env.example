# Copy this file to .env and fill in the values. Never commit .env.
# Share secrets via password manager (1Password, Bitwarden), not Discord/email.

# OpenSky Network — register at https://opensky-network.org (research account
# required for the Trino/Impala bulk export used in backend/scripts/export_lemd_2025_sample.py)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Supabase projects — multi-account scheme.
#
# The pipeline runs in cycles, each on a fresh Supabase project (free-tier
# 500 MB rotates). Add one URL/KEY pair per cycle and switch the active cycle
# from the validation notebook (ACCOUNT_SLUG="cycle2").
#
# The service-role key bypasses RLS; treat it like a password. Ask Monica
# for project URLs and keys.
SUPABASE_URL_CYCLE1=
SUPABASE_KEY_CYCLE1=
SUPABASE_URL_CYCLE2=
SUPABASE_KEY_CYCLE2=
# ... add SUPABASE_URL_CYCLE3 / SUPABASE_KEY_CYCLE3 as new cycles land

# Unsuffixed legacy keys — kept because backend/core/config.py evaluates
# Settings() at module load with these as required fields. Required for any
# code that touches `backend.crud.opensky` or `backend.crud.supabase_io`
# (the validation notebook imports both). Fill with any one cycle's values,
# or with placeholder strings if you only use the notebook against a
# suffixed cycle.
SUPABASE_URL=
SUPABASE_KEY=

# LLM analysis reports (build-time only — generated by backend/serve/precompute.py,
# baked into the bundle, served static; never needed at serve time / on the HF Space).
ANTHROPIC_API_KEY=
# Optional: pin the model (default claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Public approach-evaluation admission budgets per 60-second process window.
SADAR_EVALUATION_GLOBAL_LIMIT=10
SADAR_EVALUATION_CLIENT_LIMIT=5
