# Copy this file to .env and fill in the values. Never commit .env.
# Share secrets via password manager (1Password, Bitwarden), not Discord/email.

# OpenSky Network — register at https://opensky-network.org (research account
# required for the historical bulk-export path in
# backend/research/src/sadar_research/trajectory_anomaly/data/export_sample.py)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Supabase projects — multi-account scheme.
#
# The pipeline runs in cycles, each on a fresh Supabase project (free-tier
# 500 MB rotates). Add one URL/KEY pair per cycle and switch the active cycle
# from the historical validation notebook (ACCOUNT_SLUG="cycle2").
#
# The service-role key bypasses RLS; treat it like a password. Ask Monica
# for project URLs and keys.
SUPABASE_URL_CYCLE1=
SUPABASE_KEY_CYCLE1=
SUPABASE_URL_CYCLE2=
SUPABASE_KEY_CYCLE2=
# ... add SUPABASE_URL_CYCLE3 / SUPABASE_KEY_CYCLE3 as new cycles land

# Unsuffixed research keys. The historical OpenSky helper evaluates its settings
# when imported by the validation notebook. Fill these with the selected cycle's
# values, or placeholders when only the suffixed Supabase connection is used.
SUPABASE_URL=
SUPABASE_KEY=

# Historical LLM analysis reports (research build-time only; never needed by the
# current rules-first runtime).
ANTHROPIC_API_KEY=
# Optional: pin the model (default claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Product runtime. The container supplies both directory paths; set them when
# running `sadar-api` directly from a checkout.
SADAR_APPROACH_RELEASE_DIR=
SADAR_FRONTEND_DIR=
SADAR_ENABLE_EVALUATION=false

# Public approach-evaluation admission budgets per process window.
SADAR_EVALUATION_RATE_WINDOW_S=60
SADAR_EVALUATION_GLOBAL_LIMIT=10
SADAR_EVALUATION_CLIENT_LIMIT=5
# Hard wall-clock deadline for one isolated evaluation worker.
SADAR_EVALUATION_TIMEOUT_S=60
